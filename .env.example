# Database (optional; when omitted the app uses embedded PGlite under STORAGE_DIR)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Session cookie signing secret (change in production)
SESSION_SECRET=change-me
# Storage root for uploads, extracted text, audio (local adapter)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=60
# Jobs
JOB_CONCURRENCY=1
# TTS – Kokoro (default, local CPU)
KOKORO_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
KOKORO_DTYPE=q8            # fp32 | fp16 | q8 | q4 | q4f16
# Optional self-hosted GPU engine (OpenAI-compatible /v1/audio/speech), e.g. Qwen3-TTS or Chatterbox
# TTS_HTTP_URL=http://gpu-box:8000
# TTS_HTTP_MODEL=qwen3-tts
# TTS_HTTP_STYLE_CONTROL=1
# TTS_HTTP_VOICES=[{"engineVoiceId":"Ryan","name":"Ryan","gender":"male","accent":"American","ageRange":"adult","pitch":"medium-low","style":["warm"],"quality":0.95}]
# TTS_DEFAULT_ENGINE=kokoro
# OCR
OCR_MAX_PAGES=400
# Free-book catalog
GUTENDEX_URL=https://gutendex.com
